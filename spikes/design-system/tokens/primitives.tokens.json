{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "primitive": {
    "color": {
      "neutral": {
        "0": { "$type": "color", "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "alpha": 1, "hex": "#FFFFFF" } },
        "50": { "$type": "color", "$value": { "colorSpace": "srgb", "components": [0.972549, 0.980392, 0.988235], "alpha": 1, "hex": "#F8FAFC" } },
        "300": { "$type": "color", "$value": { "colorSpace": "srgb", "components": [0.796078, 0.835294, 0.882353], "alpha": 1, "hex": "#CBD5E1" } },
        "500": { "$type": "color", "$value": { "colorSpace": "srgb", "components": [0.392157, 0.454902, 0.545098], "alpha": 1, "hex": "#64748B" } },
        "600": { "$type": "color", "$value": { "colorSpace": "srgb", "components": [0.278431, 0.333333, 0.411765], "alpha": 1, "hex": "#475569" } },
        "800": { "$type": "color", "$value": { "colorSpace": "srgb", "components": [0.117647, 0.160784, 0.231373], "alpha": 1, "hex": "#1E293B" } },
        "900": { "$type": "color", "$value": { "colorSpace": "srgb", "components": [0.058824, 0.090196, 0.164706], "alpha": 1, "hex": "#0F172A" } }
      },
      "blue": {
        "300": { "$type": "color", "$value": { "colorSpace": "srgb", "components": [0.576471, 0.772549, 0.992157], "alpha": 1, "hex": "#93C5FD" } },
        "400": { "$type": "color", "$value": { "colorSpace": "srgb", "components": [0.376471, 0.647059, 0.980392], "alpha": 1, "hex": "#60A5FA" } },
        "700": { "$type": "color", "$value": { "colorSpace": "srgb", "components": [0.113725, 0.305882, 0.847059], "alpha": 1, "hex": "#1D4ED8" } },
        "800": { "$type": "color", "$value": { "colorSpace": "srgb", "components": [0.117647, 0.25098, 0.686275], "alpha": 1, "hex": "#1E40AF" } }
      },
      "red": {
        "300": { "$type": "color", "$value": { "colorSpace": "srgb", "components": [0.988235, 0.647059, 0.647059], "alpha": 1, "hex": "#FCA5A5" } },
        "700": { "$type": "color", "$value": { "colorSpace": "srgb", "components": [0.72549, 0.109804, 0.109804], "alpha": 1, "hex": "#B91C1C" } }
      },
      "black": { "$type": "color", "$value": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 1, "hex": "#000000" } },
      "blackOverlay": { "$type": "color", "$value": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.6, "hex": "#000000" } }
    },
    "space": {
      "4": { "$type": "dimension", "$value": { "value": 4, "unit": "px" } },
      "8": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } },
      "12": { "$type": "dimension", "$value": { "value": 12, "unit": "px" } },
      "16": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } },
      "20": { "$type": "dimension", "$value": { "value": 20, "unit": "px" } },
      "24": { "$type": "dimension", "$value": { "value": 24, "unit": "px" } },
      "32": { "$type": "dimension", "$value": { "value": 32, "unit": "px" } },
      "44": { "$type": "dimension", "$value": { "value": 44, "unit": "px" } }
    },
    "radius": {
      "8": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } },
      "12": { "$type": "dimension", "$value": { "value": 12, "unit": "px" } }
    },
    "font": {
      "family": { "$type": "fontFamily", "$value": ["system-ui", "sans-serif"] },
      "size": {
        "14": { "$type": "dimension", "$value": { "value": 14, "unit": "px" } },
        "16": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } },
        "20": { "$type": "dimension", "$value": { "value": 20, "unit": "px" } }
      },
      "weight": {
        "regular": { "$type": "fontWeight", "$value": 400 },
        "semibold": { "$type": "fontWeight", "$value": 600 },
        "bold": { "$type": "fontWeight", "$value": 700 }
      },
      "line": {
        "body": { "$type": "number", "$value": 1.5 },
        "compact": { "$type": "number", "$value": 1.25 }
      }
    }
  }
}


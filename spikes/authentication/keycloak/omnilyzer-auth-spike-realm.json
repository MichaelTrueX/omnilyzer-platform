{
  "realm": "omnilyzer-auth-spike",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "loginWithEmailAllowed": true,
  "clients": [
    {
      "clientId": "omnilyzer-bff-spike",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${OMNILYZER_BFF_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://testserver/auth/callback"],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "omnilyzer-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "omnilyzer-api-spike",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "omnilyzer-native-spike",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["com.omnilyzer.authspike:/oauth2redirect/keycloak"],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "omnilyzer-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "omnilyzer-api-spike",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "omnilyzer-api-spike",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [],
      "webOrigins": []
    }
  ],
  "users": [
    {
      "username": "auth-spike-user",
      "enabled": true,
      "email": "auth-spike-user@example.invalid",
      "emailVerified": true,
      "firstName": "Auth",
      "lastName": "Spike",
      "requiredActions": [],
      "credentials": [
        {
          "type": "password",
          "value": "${OMNILYZER_TEST_PASSWORD}",
          "temporary": false
        }
      ]
    }
  ]
}

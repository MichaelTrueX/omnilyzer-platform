          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "security": [
          {
            "SyntheticHeaderAuthentication": []
          }
        ],
        "summary": "Project Create",
        "tags": [
          "projects"
        ]
      }
    },

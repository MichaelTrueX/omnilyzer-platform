                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": ""
          }
        },
        "security": [
          {
            "syntheticActor": []
          }
        ],
        "tags": [
          "projects"
        ]
      }
    },

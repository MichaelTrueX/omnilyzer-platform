      "patch": {
        "description": "Apply a validated non-empty partial update.",
        "operationId": "drf_update_project",
        "parameters": [
          {
            "in": "header",
            "name": "X-Workspace-ID",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "project_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PatchedProjectPatchRequest"
              }
            }
          }
        },
        "responses": {
          "200": {

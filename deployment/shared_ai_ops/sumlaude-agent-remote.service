[Unit]
Description=sumlaude limited Desktop Commander agent (runs as non-admin OS user)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=sumlaude-agent
Group=sumlaude-agent
WorkingDirectory=/home/sumlaude-agent
ExecStart=/usr/bin/node /home/sumlaude-agent/.local/share/sumlaude-agent/node_modules/@wonderwhy-er/desktop-commander/dist/index.js remote
Environment=HOME=/home/sumlaude-agent
Environment=PATH=/usr/bin:/bin
NoNewPrivileges=yes
UMask=0077
ProtectSystem=strict
ReadWritePaths=/home/sumlaude-agent
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target

// Permanent least-privilege entry point for two non-admin remote agent accounts.
// Exact product-specific systemd template only, start verb only.
// Do not grant other systemd verbs, units, sudo, pkexec or manage-unit-files.
polkit.addRule(function(action, subject) {
    if (action.id !== "org.freedesktop.systemd1.manage-units" ||
        action.lookup("verb") !== "start") {
        return;
    }
    var unit = action.lookup("unit") || "";
    if (subject.user === "sumlaude-agent" &&
        /^sumlaude-ai-ops@[a-z][a-z0-9-]{0,39}\.service$/.test(unit)) {
        return polkit.Result.YES;
    }
    if (subject.user === "omnilyzer-agent" &&
        /^omnilyzer-ai-ops@[a-z][a-z0-9-]{0,39}\.service$/.test(unit)) {
        return polkit.Result.YES;
    }
});

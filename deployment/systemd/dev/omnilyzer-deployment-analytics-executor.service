# File: deployment/systemd/dev/omnilyzer-deployment-analytics-executor.service
# Purpose: inert, separately approved Task014 Analytics first-install service.
# Related: deployment/analytics_executor_service_entrypoint.py,
#          deployment/analytics_executor_service_config.py,
#          deployment/systemd/dev/omnilyzer-deployment-analytics-executor.socket,
#          deployment/systemd/rootless/rootless-docker-executor-socket.conf.
# Import/checkout does not install/enable/start this service.

[Unit]
Description=Omnilyzer DEV Analytics Task014 private executor
Requires=omnilyzer-deployment-analytics-executor.socket
After=omnilyzer-deployment-analytics-executor.socket
# A separate reviewed, root-owned authorization is mandatory before startup.
ConditionPathExists=/etc/omnilyzer/deployment/dev/analytics-executor.json

[Service]
Type=exec
User=omnilyzer-executor
Group=omnilyzer-executor
SupplementaryGroups=omnilyzer-replay
WorkingDirectory=/opt/omnilyzer/deployment/analytics-app
ExecStart=/opt/omnilyzer/deployment/venv/bin/python -m deployment.analytics_executor_service_entrypoint
Restart=no
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
# Keep home and user-runtime trees hidden in private read-only tmpfs mounts.
# Only two fixed UID991 sockets are re-exposed under /run/user so the original
# read-only Analytics active-state inspector can use its pinned absolute paths.
# Do not replace with ProtectHome=no or expose all of /run/user/991.
ProtectHome=tmpfs
ProtectSystem=strict
ReadWritePaths=/var/lib/omnilyzer/deployment
# Preserve the original private Docker CLI alias for V1 compatibility.
BindReadOnlyPaths=/run/user/991/docker.sock:/run/omnilyzer/deployment/rootless-docker/docker.sock
# Re-expose only the two fixed UID991 IPC sockets. Read-only filesystem
# binds DO NOT limit AF_UNIX messages; existing original UID991/OIDC/route
# controls remain mandatory for any state-changing API request.
BindReadOnlyPaths=/run/user/991/docker.sock:/run/user/991/docker.sock
BindReadOnlyPaths=/run/user/991/dockerd-rootless/api.sock:/run/user/991/dockerd-rootless/api.sock
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Omnilyzer Task 014 deployment audit event",
  "$comment": "AuditEvent.from_dict is authoritative for exact built-in integer types, cross-field OIDC time arithmetic, and the aggregate canonical MAX_EVENT_BYTES limit. Draft 2020-12 defines integral JSON numbers such as 1.0 as integers, has no cross-property arithmetic, and cannot bound the byte size of the complete canonical serialization.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "event_id", "event_type", "stage", "release_version",
    "source_sha", "oci_repository", "digest", "previous_digest", "active_slot",
    "candidate_slot", "execution_identity", "migration_identity", "result", "timestamp"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 2},
    "event_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^(?![\\s\\S]*[^A-Za-z0-9._:-])[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "event_type": {"enum": [
      "promotion_requested", "promotion_rejected", "promotion_started",
      "migration_started", "migration_succeeded", "migration_failed",
      "liveness_passed", "liveness_failed", "readiness_passed", "readiness_failed",
      "traffic_switch_started", "traffic_switch_succeeded", "traffic_switch_failed",
      "promotion_succeeded", "promotion_failed",
      "rollback_started", "rollback_succeeded", "rollback_failed"
    ]},
    "stage": {"enum": ["dev", "staging", "prod"]},
    "release_version": {"type": "string", "minLength": 5, "pattern": "^(?![\\s\\S]*[^0-9.])(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "source_sha": {"type": "string", "minLength": 40, "maxLength": 40, "pattern": "^(?!0{40}$)[0-9a-f]{40}$"},
    "oci_repository": {"enum": ["omnilyzer/task013-release-canary"]},
    "digest": {"type": "string", "minLength": 71, "maxLength": 71, "pattern": "^sha256:[0-9a-f]{64}$"},
    "previous_digest": {"anyOf": [{"type": "null"}, {"type": "string", "minLength": 71, "maxLength": 71, "pattern": "^sha256:[0-9a-f]{64}$"}]},
    "active_slot": {"enum": ["blue", "green", null]},
    "candidate_slot": {"enum": ["blue", "green", null]},
    "execution_identity": {
      "type": "object",
      "$comment": "OIDC expiry ordering and the 300-second cross-field lifetime bound are additionally enforced by AuditExecutionIdentity because JSON Schema draft 2020-12 has no standard cross-property arithmetic keyword.",
      "additionalProperties": false,
      "required": [
        "schema_version", "requested_by_actor_id", "github_repository_id",
        "github_workflow_ref", "github_workflow_sha", "github_run_id",
        "github_run_attempt", "oidc_jti", "oidc_issued_at", "oidc_expires_at",
        "promotion_request_sha256", "executor_request_sha256"
      ],
      "properties": {
        "schema_version": {"type": "integer", "const": 1},
        "requested_by_actor_id": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
        "github_repository_id": {"type": "integer", "const": 1350104356},
        "github_workflow_ref": {"const": "MichaelTrueX/omnilyzer-platform/.github/workflows/platform-promote.yml@refs/heads/main"},
        "github_workflow_sha": {"type": "string", "minLength": 40, "maxLength": 40, "pattern": "^(?!0{40}$)[0-9a-f]{40}$"},
        "github_run_id": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
        "github_run_attempt": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
        "oidc_jti": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^(?!.*\\.\\.)(?![\\s\\S]*[^A-Za-z0-9._:@-])[A-Za-z0-9][A-Za-z0-9._:@-]{0,127}$"},
        "oidc_issued_at": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
        "oidc_expires_at": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
        "promotion_request_sha256": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$"},
        "executor_request_sha256": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "migration_identity": {"anyOf": [{"type": "null"}, {"type": "string", "minLength": 1, "maxLength": 255, "pattern": "^(?![\\s\\S]*[^A-Za-z0-9._:/@-])[A-Za-z0-9][A-Za-z0-9._:/@-]{0,254}$"}]},
    "result": {"enum": ["started", "succeeded", "failed", "rejected"]},
    "timestamp": {"type": "string", "minLength": 20, "maxLength": 20, "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"}
  },
  "allOf": [
    {"if": {"properties": {"event_type": {"const": "promotion_failed"}}},
     "then": {"properties": {"result": {"const": "failed"}}}},
    {"if": {"properties": {"event_type": {"pattern": "^migration_"}}},
     "then": {"properties": {"migration_identity": {"type": "string"}}}},
    {"if": {"properties": {"event_type": {"pattern": "^rollback_"}}},
     "then": {"properties": {"previous_digest": {"type": "string"}}}}
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Omnilyzer Task 014 deployment audit event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "event_id", "event_type", "stage", "release_version",
    "source_sha", "oci_repository", "digest", "previous_digest", "active_slot",
    "candidate_slot", "actor", "migration_identity", "result", "timestamp"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "event_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "event_type": {"enum": [
      "promotion_requested", "promotion_rejected", "promotion_started",
      "migration_started", "migration_succeeded", "migration_failed",
      "liveness_passed", "liveness_failed", "readiness_passed", "readiness_failed",
      "traffic_switch_started", "traffic_switch_succeeded", "traffic_switch_failed",
      "promotion_succeeded", "rollback_started", "rollback_succeeded", "rollback_failed"
    ]},
    "stage": {"enum": ["dev", "staging", "prod"]},
    "release_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "source_sha": {"type": "string", "pattern": "^(?!0{40}$)[0-9a-f]{40}$"},
    "oci_repository": {"enum": ["omnilyzer/task013-release-canary"]},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "previous_digest": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}]},
    "active_slot": {"enum": ["blue", "green", null]},
    "candidate_slot": {"enum": ["blue", "green", null]},
    "actor": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{0,254}$"},
    "migration_identity": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{0,254}$"}]},
    "result": {"enum": ["started", "succeeded", "failed", "rejected"]},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
  },
  "allOf": [
    {"if": {"properties": {"event_type": {"pattern": "^migration_"}}},
     "then": {"properties": {"migration_identity": {"type": "string"}}}},
    {"if": {"properties": {"event_type": {"pattern": "^rollback_"}}},
     "then": {"properties": {"previous_digest": {"type": "string"}}}}
  ]
}
